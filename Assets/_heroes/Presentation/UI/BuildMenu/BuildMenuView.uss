.build-menu {
    position: absolute;
    left: 50%;
    bottom: 24px;
    translate: -50% 0;
    width: 860px;
    height: 180px;
    background-color: rgba(176, 156, 133, 0.82);
    border-top-width: 3px;
    border-top-color: #7a1a12;
    border-bottom-width: 3px;
    border-bottom-color: #7a1a12;
    padding: 8px 12px 10px 12px;
    -unity-font-definition: resource("Fonts/JuliusSansOne SDF");
    color: #f0d08a;
}

.build-menu__header {
    height: 24px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: #7a1a12;
}

.build-menu__title {
    font-size: 14px;
    letter-spacing: 2px;
    color: #f5d18b;
}

.build-menu__header-ornaments {
    flex-grow: 1;
}

.build-menu__body {
    flex-direction: row;
    flex-grow: 1;
}

.build-menu__tabs {
    width: 44px;
    justify-content: space-between;
    align-items: center;
    padding-top: 6px;
}

.build-menu__tab {
    width: 28px;
    height: 28px;
    border-width: 2px;
    border-color: #7a1a12;
    background-color: #d5b171;
}

.build-menu__tab--active {
    border-color: #46c0ff;
}

.build-menu__content {
    flex-grow: 1;
    padding-left: 8px;
}

.build-menu__summary {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    margin-bottom: 8px;
}

.build-menu__summary-label {
    font-size: 10px;
    letter-spacing: 2px;
    margin-right: 6px;
    color: #d6a23b;
}

.build-menu__gold {
    font-size: 14px;
    color: #f7d483;
}

.build-menu__list {
    flex-grow: 1;
    height: 118px;
}

.build-menu__list .unity-scroll-view__content-container {
    flex-direction: row;
    align-items: center;
}

.build-menu__list .unity-scroll-view__horizontal-scroller {
    display: none;
}

.build-menu__list .unity-scroll-view__vertical-scroller {
    display: none;
}

.build-menu__list .unity-list-view__item {
    flex-direction: row;
}

.build-menu__item {
    width: 120px;
    height: 120px;
    margin-right: 8px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.build-menu__item-frame {
    width: 84px;
    height: 84px;
    background-image: resource("Images/socket_big");
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
    align-items: center;
    justify-content: center;
}

.build-menu__item-icon {
    width: 48px;
    height: 48px;
    background-image: resource("Images/detail");
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
}

.build-menu__item-meta {
    align-items: center;
    margin-top: 6px;
}

.build-menu__item-name {
    font-size: 10px;
    color: #f2d190;
}

.build-menu__item-cost {
    font-size: 9px;
    color: #d6a23b;
}

.build-menu__item--selected .build-menu__item-frame {
    background-image: resource("Images/socket_big_blue");
}

.build-menu__item--disabled {
    opacity: 0.45;
}
