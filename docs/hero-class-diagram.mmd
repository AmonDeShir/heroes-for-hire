%% external / skrócone zależności
class ItemDefinition
class BuildingFacade
class GameWorldStateManager
class IDamageable
class NavMeshAgent
class ProximitySensor
class MonsterFacade

HeroDefinition --> HeroFacade : Prefab
HeroFacade *-- HeroModel
HeroModel *-- HealthModel
HeroFacade o-- HeroAgent
HeroFacade o-- HeroEnemySensor
HeroFacade o-- TimedEffectRunner
HeroFacade o-- DamageLogic
HeroFacade o-- HealLogic
HeroFacade o-- NavMeshAgent

HeroModel ..> ItemDefinition : equip/bonuses

TimedEffectRunner --> HeroFacade : writes timed stats
TimedEffectRunner --> DamageLogic : DoT

HeroSpawnService --> HeroDefinition
HeroSpawnService --> BuildingFacade
HeroSpawnService --> GameWorldStateManager
HeroSpawnService --> HeroFacade : Instantiate+Initialize

HeroRosterService ..> HeroFacade : via Registry

HeroReviveService --> HeroRosterService
HeroReviveService ..> BuildingFacade : chapel spawn

HeroEnemySensor --|> ProximitySensor
HeroEnemySensor ..> MonsterFacade : detects
HeroAgent --> GameWorldStateManager : world snapshot/state
HeroAgent --> HeroFacade : reads Model/Definition/Sensor

%% Buildings graph
BuildingCatalog --> BuildingDefinition
BuildingDefinition --> BuildingFacade : Prefab
BuildingFacade *-- BuildingModel
BuildingModel *-- HealthModel
BuildingFacade o-- BuildingConstructionLogic

BuildingPlacementController --> BuildingPlacementSelectionService
BuildingPlacementController --> BuildingPlacementService
BuildingPlacementController --> BuildingCatalog
BuildingPlacementService --> KingdomService
BuildingPlacementService --> BuildingDefinition
BuildingPlacementService --> BuildingFacade : Instantiate+Initialize

BuildingIncomeService --> KingdomService
BuildingIncomeService ..> BuildingFacade : reads Registry

BuildingPopulationService --> KingdomService
BuildingPopulationService ..> BuildingFacade : reads Registry

BuildingDefinition --> BuildingUpgradeDefinition : AvailableUpgrades
BuildingModel *-- QueueModel : UpgradeQueue
BuildingFacade o-- QueueLogic~...~ : upgrades ticking
BuildingUpgradeService --> KingdomService
BuildingUpgradeService ..> HeroSpawnService
BuildingUpgradeService ..> BuildingFacade : mutate model
BuildingUpgradeDefinition --> BuildingUpgradeEffect
BuildingUpgradeEffect --> BuildingUpgradeContext
SpawnHeroEffect --|> BuildingUpgradeEffect
SpawnHeroEffect --> HeroDefinition
