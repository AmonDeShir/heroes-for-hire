{
    "compilerOptions": {
        "ignoreDeprecations": "6.0",
        "baseUrl": ".",
        "paths": {
            "@/*": ["*"],
            "onejs": [ "node_modules/onejs-core" ],
            "onejs/*": [ "node_modules/onejs-core/*" ],
            "preact": [ "node_modules/onejs-preact", "node_modules/preact" ],
            "preact/*": [ "node_modules/onejs-preact/*", "node_modules/preact/*" ]
        },
        "outDir": "@outputs/tsc",
        "lib": [ "esnext" ],
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "Bundler",
        "jsx": "react",
        "jsxFactory": "h",
        "jsxFragmentFactory": "Fragment",
        "typeRoots": [ "./node_modules/@types", "./index.d.ts" ],
        "sourceMap": true,
        "skipLibCheck": true
    },
    "exclude": [ "tmp" ]
}
